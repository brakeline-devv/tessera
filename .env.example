# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=            # a key just for this project, with a monthly spend limit set in the Anthropic console
KILN_TREASURY=                # wallet that receives ETH deposits on Robinhood Chain
PUBLIC_URL=https://example.com
PORT=6700
KILN_BRAND=Molten
KILN_MARKUP=0.3               # 30% over Claude's list price
KILN_DEPOSIT_CAP_USD=50       # per wallet, lifetime, during the pilot
KILN_CONFIRMATIONS=3
KILN_WELCOME=0                # free credits for a new wallet
KILN_DEV_FAUCET=0             # 1 only for local testing
KILN_DAILY_BUDGET_USD=20      # max Claude spend per rolling 24h across all users; jobs past it are refused
KILN_JOBS_PER_DAY=40          # per wallet
KILN_JOBS_PER_DAY_TOTAL=400   # whole studio
KILN_BACKUP_KEEP=14           # daily database copies kept in data/backups
